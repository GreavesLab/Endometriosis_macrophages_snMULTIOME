# Figure 3A ----

Idents(rrx.integrated) <- rrx.integrated$sample_id
sample_markers <- FindAllMarkers(rrx.integrated, assay = "RNA", test.use = "MAST")
samples <- unique(sample_markers) 

gsea_by_sample <- list()
for (samp in samples) {
  markers <- sample_markers %>% filter(cluster == samp)
  
  gene_list <- sort(setNames(markers$avg_log2FC, markers$gene), decreasing = TRUE)
  
  gsea <- gseGO(geneList     = gene_list,
                OrgDb        = org.Mm.eg.db,
                ont          = "MF",
                keyType      = "SYMBOL",
                minGSSize    = 15,
                maxGSSize    = 500,
                pvalueCutoff = 1,
                verbose      = FALSE)
  
  gsea_by_sample[[samp]] <- gsea  
  message(paste("Finished:", samp))
}

all_gsea <- bind_rows(
  as.data.frame(gsea_by_sample$endo_control) %>% mutate(sample = "Vehicle"),
  as.data.frame(gsea_by_sample$endo_drug)    %>% mutate(sample = "RRx-001"),
  as.data.frame(gsea_by_sample$sham)         %>% mutate(sample = "Sham")
)

top_paths <- all_gsea %>%
  filter(p.adjust < 0.05) %>%
  group_by(sample) %>%
  slice_max(abs(NES), n = 3) %>%
  pull(Description) %>%
  unique()

get_ids <- function(gsea_obj, paths) {
  gsea_obj@result %>%
    filter(Description %in% paths) %>%
    pull(ID)
}

p_sham <- gseaplot2(gsea_by_sample$sham, 
                    geneSetID = get_ids(gsea_by_sample$sham, top_paths), 
                    pvalue_table = FALSE)

p_endo <- gseaplot2(gsea_by_sample$endo_control, 
                    geneSetID = get_ids(gsea_by_sample$endo_control, top_paths), 
                    pvalue_table = FALSE)

p_drug <- gseaplot2(gsea_by_sample$endo_drug, 
                    geneSetID = get_ids(gsea_by_sample$endo_drug, top_paths), 
                    pvalue_table = FALSE)



p_sham_grob  <- as.grob(p_sham)
p_endo_grob  <- as.grob(p_endo)
p_drug_grob  <- as.grob(p_drug)

plot_grid(p_sham_grob, p_endo_grob, p_drug_grob, ncol = 3)

