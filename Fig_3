cluster_res_gse_go_s <- simplify(
  cluster_res_gse_go,
  cutoff = 0.7,
  by = "p.adjust",
  select_fun = min,
  measure = "Wang",
  semData = NULL
)

enrichplot::dotplot(cluster_res_gse_go_s, showCategory = 5, includeAll = FALSE, font.size = 8, split = '.sign') + facet_grid(~.sign) + 
