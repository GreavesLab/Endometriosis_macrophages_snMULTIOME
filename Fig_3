# Figure 3D ----
lineages <- slingLineages(sling.umap)
condition_sling <- sce$sample_id

pt <- slingPseudotime(sling.umap, na=FALSE)
cw <- slingCurveWeights(sling.umap)
assignment <- apply(cw, 1, which.max)
ptAs <- c() #assigned pseudotime
for(ii in 1:nrow(pt)) ptAs[ii] <- pt[ii,assignment[ii]] 

cond1 <- factor(condition_sling[assignment == 1])
t1 <- ptAs[assignment == 1]
model1 <- nnet::multinom(cond1 ~ t1)
zvalues1 <- summary(model1)$coefficients / summary(model1)$standard.errors
pnorm(abs(zvalues1), lower.tail=FALSE)*2

model1_1 <- glm(cond1 ~ t1, family = glm)

dses_1 <- data.frame(t1 = seq(min(t1),max(t1),length.out = 100))
predictions_lineage1 <- predict(model1, newdata = dses_1, "probs")
plot(dses_1$t1, unname(predictions_lineage1[,1]), pch = 20, col = "royalblue1",xlab = 'Pseudotime',ylab = 'Probability',ylim = c(0,0.75), main = 'Lineage 1')
points(dses_1$t1, unname(predictions_lineage1[,2]), pch = 20, col = "firebrick1")
points(dses_1$t1, unname(predictions_lineage1[,3]), pch = 20, col = "blueviolet")
legend('right', legend=c("Sham", "Vehicle", "RRx-001"), col=c("blueviolet","royalblue1", "firebrick1"), pch = 20, cex=1, bty = "n")


