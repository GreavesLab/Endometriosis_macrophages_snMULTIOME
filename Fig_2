# Figure 2H ----
all_markers <- FindAllMarkers(rrx.integrated, 
                              only.pos = TRUE,
                              min.pct = 0.25,
                              logfc.threshold = 0.25)

go_results <- lapply(unique(all_markers$cluster), function(cl) {
  genes <- all_markers %>%
    filter(cluster == cl, p_val_adj < 0.05) %>%
    pull(gene)
  
  enrichGO(gene          = genes,
           OrgDb         = org.Mm.eg.db,
           keyType       = "SYMBOL",
           ont           = "BP",
           pAdjustMethod = "BH",
           pvalueCutoff  = 0.05,
           qvalueCutoff  = 0.05)
})
names(go_results) <- unique(all_markers$cluster)

go_results_s <- lapply(go_results, function(res) {
  req <- tryCatch(
    simplify(
      res,
      cutoff     = 0.7,
      by         = "p.adjust",
      select_fun = min,
      measure    = "Wang",
      semData    = NULL
    ),
    error = function(e) NULL  
  )
})
names(go_results_s) <- names(go_results)

go_results_s <- Filter(Negate(is.null), go_results_s)

top_go <- bind_rows(lapply(names(go_results_s), function(cl) {
  res <- go_results[[cl]]
  if (is.null(res) || nrow(res@result) == 0) return(NULL)
  res@result %>%
    arrange(pvalue) %>%
    slice_head(n = 20) %>%
    mutate(cluster = cl)
}))

top_go %>%
  group_by(Description) %>%
  summarise(clusters = list(cluster)) %>%
  ggplot(aes(x = clusters, fill = after_stat(count))) +
  geom_bar() +
  scale_x_upset() +
  scale_fill_viridis_c(option = "viridis", direction = -1, name = "GO terms") +
  labs(x = NULL, y = "Number of GO terms",
       title = "GO term sharing across clusters") +
  theme_classic()

# Figure 2I ----
top_go %>%
  filter(cluster %in% clusters_to_plot) %>%
  group_by(cluster) %>%
  slice_min(p.adjust, n = 5, with_ties = FALSE) %>%   # top 5 per cluster (explicit)
  ungroup() %>%
  mutate(term = paste(Description, cluster, sep = "___"),   # unique per facet
         term = reorder(term, Count)) %>%
  ggplot(aes(x = Count, y = term, fill = p.adjust)) +
  geom_col() +
  scale_y_discrete(labels = function(x) stringr::str_wrap(sub("___.*$", "", x), 30)) +
  scale_fill_viridis_c(
    direction = 1,
    trans     = "log10",
    limits    = c(1e-5, 0.05),
    breaks    = c(1e-5, 1e-4, 1e-3, 0.01, 0.05),
    labels    = scales::scientific,
    oob       = scales::squish,
    name      = "Adj. p-value",
    guide     = guide_colourbar(reverse = TRUE)
  ) +
  facet_wrap(~ cluster, scales = "free_y", ncol = 3) +
  labs(x = "Gene count", y = NULL,
       title = "Top GO:BP terms per macrophage cluster") +
