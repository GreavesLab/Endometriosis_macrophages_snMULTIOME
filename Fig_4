# Figure 4C ----
top_motifs <- motif_combined %>%
  dplyr::group_by(cluster) %>%
  dplyr::arrange(p.adjust) %>%
  dplyr::slice_head(n = 5) %>%
  dplyr::ungroup()

ggplot(top_motifs, aes(x = cluster, y = motif.name, 
                       size = fold.enrichment, 
                       colour = -log10(p.adjust))) +
  geom_point() +
  scale_colour_viridis_c(name = "-log10(p.adjust)") +
  scale_size_continuous(name = "Fold enrichment") +
  theme_bw() +
  labs(x = "Cluster", y = "TF Motif", 
       title = "Enriched TF motifs by macrophage cluster") +
  theme(axis.text.x = element_text(angle = 45, hjust = 1))

